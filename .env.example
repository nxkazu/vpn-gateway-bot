# ==========================================================================
# Tessera VPN Telegram Bot - environment configuration
# Copy this file to `.env` and fill in real values.
# ==========================================================================

# --- Telegram ---
# Bot token obtained from @BotFather
BOT_TOKEN=123456:ABC-DEF...
# Bot username WITHOUT leading @ (used to build referral deep-links)
BOT_USERNAME=TesseraVpnBot
# Comma-separated list of Telegram user IDs that have admin access
ADMIN_IDS=111111111,222222222
# Optional RBAC. ADMIN_IDS and ADMIN_SUPERADMIN_IDS are full-access superadmins.
# ADMIN_ROLES format: 111:support,billing;222:ops
ADMIN_SUPERADMIN_IDS=
ADMIN_SUPPORT_IDS=
ADMIN_BILLING_IDS=
ADMIN_OPS_IDS=
ADMIN_ROLES=

# --- Remnawave panel API ---
# Base URL of your Remnawave panel, e.g. https://panel.example.com
REMNAWAVE_BASE_URL=https://panel.example.com
# Long-lived API token created in the panel (API Tokens section) OR via /api/tokens
REMNAWAVE_TOKEN=your-remnawave-api-token
# Optional: UUID of the default internal squad new users are assigned to
REMNAWAVE_DEFAULT_SQUAD_UUID=

# --- Database (PostgreSQL) ---
DB_HOST=postgres
DB_PORT=5432
DB_NAME=tessera
DB_USER=tessera
DB_PASSWORD=change-me-strong-password

# --- Business rules ---
# Trial period length (days) granted on first /start (0 disables trial)
TRIAL_DAYS=3
# Traffic limit for trial in GB (0 = unlimited)
TRIAL_TRAFFIC_GB=20
# Reward (in days) granted to a referrer when a referred user activates a paid plan
REFERRAL_REWARD_DAYS=15
# Default traffic limit strategy: NO_RESET | DAY | WEEK | MONTH | MONTH_ROLLING
DEFAULT_TRAFFIC_STRATEGY=MONTH
# Production safety: keep false unless you intentionally want paid plans to activate
# without a payment provider (useful only for local/dev environments).
ALLOW_FREE_ACTIVATION=false
# --- Payments: Telegram Stars (built-in, zero configuration) ---
# Native in-chat payments in Telegram Stars (XTR). Works for EVERY bot without any
# merchant credentials. Set false to hide the Stars payment method.
STARS_ENABLED=true
# Conversion rate used to derive the Stars price from RUB plan prices
# (roughly what one star costs your users; amounts are always rounded up).
STARS_RUB_PER_STAR=1.6
# --- Payments (tessera-payment.jar) ---
# CryptoBot (Crypto Pay API): create an app via @CryptoBot -> Crypto Pay -> Create App
CRYPTOBOT_TOKEN=
# Platega merchant credentials (sent as X-MerchantId / X-Secret)
PLATEGA_MERCHANT_ID=
PLATEGA_SECRET=
# Where module jars / module configs live (defaults: modules, config)
MODULES_DIR=modules
MODULES_CONFIG_DIR=config
# --- Admin dashboard (tessera-dashboard.jar) ---
# Token for logging into the web dashboard. Dashboard is DISABLED while empty.
DASHBOARD_TOKEN=
# Host port the dashboard is published on (container listens on 8080)
DASHBOARD_PORT=8080
# --- Telegram WebApp cabinet ---
# Mini App backend/UI. Set WEBAPP_PUBLIC_URL to your HTTPS reverse-proxy URL
# and configure the bot's Web App domain in @BotFather.
WEBAPP_ENABLED=true
WEBAPP_BIND=0.0.0.0
WEBAPP_PORT=8090
WEBAPP_PUBLIC_URL=
WEBAPP_INIT_DATA_MAX_AGE_SECONDS=86400
WEBAPP_DEVICE_RESET_LIMIT_PER_DAY=5
# --- Background workers ---
# How often (seconds) pending invoices are re-checked automatically (0 = disable).
PAYMENT_CHECK_SECONDS=60
# How often (hours) subscriptions are scanned for upcoming expiry (0 = disable).
EXPIRY_CHECK_HOURS=6
# Warn users whose subscription expires within this many days (once per expiry date).
EXPIRY_NOTIFY_DAYS=3
# --- Tessera Ops ---
# Built-in ops API: /health, /metrics, /webhooks/payments/{provider}, /ops/backups/run
OPS_ENABLED=true
OPS_BIND=0.0.0.0
OPS_PORT=9090
# Required for /metrics and /ops/backups/run. Keep secret and expose only behind TLS.
OPS_TOKEN=
# Public /health is useful for local reverse-proxy/container checks. Set false to require OPS_TOKEN.
OPS_HEALTH_PUBLIC=true
# Shared secret for payment webhooks. Send as Bearer token, X-Tessera-Webhook-Secret or ?secret=...
PAYMENT_WEBHOOK_SECRET=
# Health degradation/recovery alerts to admins. 0 disables.
OPS_ALERT_INTERVAL_SECONDS=300
# Backups use pg_dump from the runtime image. 0 disables scheduled backups.
BACKUP_DIR=/app/backups
BACKUP_SCHEDULE_HOURS=24
BACKUP_RETENTION_DAYS=7
PG_DUMP_BIN=pg_dump
# Anti-abuse limits. 0 disables each limiter.
RATE_LIMIT_MESSAGES_PER_MINUTE=30
RATE_LIMIT_CALLBACKS_PER_MINUTE=60
RATE_LIMIT_INVOICES_PER_HOUR=10
RATE_LIMIT_SUPPORT_PER_HOUR=20
# Plugin compatibility escape hatch. Keep false in production.
MODULE_ALLOW_UNSUPPORTED_API=false
